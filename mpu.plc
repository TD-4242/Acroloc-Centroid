;- DoDecreaseSpindleOR_SV           IS SV_PLC_FUNCTION_107
;- SelectSpinOR100_SV               IS SV_PLC_FUNCTION_108
;- DoEscapeKey_SV                   IS SV_PLC_FUNCTION_109
;- DoAux13Key_SV                    IS SV_PLC_FUNCTION_114
