;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; File: mfunc20.mac
; Desc: M20 -- ATC Reset (the one source of truth for the reset action)
;
; Run by the VCP ATC RESET button and system/MPGmacro4.mac; both just call M20. It
; changes to whichever dummy tool (199/200) CNC12 does not believe is loaded, because
; CNC12 skips an M6 for the loaded tool -- docs/plc-spec/atc.md.
;
; Setup: tools 199 and 200 share ONE bin in the Tool Library, H and D offsets 0.
; Follow a reset with a real T## M6.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;Skip if graphing or searching
IF #4201 || #4202 THEN GOTO 1000

; #4203 = the tool CNC12 believes is loaded. Pick the dummy that is NOT it, so the
; change can never be skipped.
IF #4203 == 200 THEN GOTO 100

T200 M6         ; normal case: 200 is not loaded, so this change runs
GOTO 1000

N100
T199 M6         ; 200 is loaded (a previous reset), so use the other dummy

N1000           ; end of program
