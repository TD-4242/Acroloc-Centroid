; Acroloc homing program (install as c:\cncm\cncm.hom on the control PC)
; Home order: Z plus first (clear the head), then X minus, then Y plus.
M92/Z
M26/Z
M91/X
M26/X
M92/Y
M26/Y
; Acroloc: every axis is at machine zero here -- pulse HomeSync_SV so the PLC latches
; the encoder counts the VCP machine-coordinate readout measures from.
M94 /6
G4 P0.25
M95 /6
