<vcp_skin>
  <border>
    <column_span>3</column_span>
    <column_start>1</column_start>
    <fill>#00007F</fill>
    <row_span>4</row_span>
    <row_start>1</row_start>
    <outline_color>#000000</outline_color>
    <outline_thickness>2</outline_thickness>
  </border>
  <border>
    <column_span>6</column_span>
    <column_start>1</column_start>
    <fill>Transparent</fill>
    <row_span>1</row_span>
    <row_start>5</row_start>
    <outline_color>#000000</outline_color>
    <outline_thickness>2</outline_thickness>
  </border>
	<border>
		<column_span>3</column_span>
		<column_start>4</column_start>
		<fill>#c6c6c6</fill>
		<row_span>3</row_span>
		<row_start>11</row_start>
		<outline_color>#000000</outline_color>
		<outline_thickness>1</outline_thickness>
		<group>feed_group</group>
	</border>
	<border>
		<column_span>3</column_span>
		<column_start>4</column_start>
		<fill>Transparent</fill>
		<row_span>1</row_span>
		<row_start>11</row_start>
		<outline_color>Transparent</outline_color>
		<outline_thickness>1</outline_thickness>
		<plc_word>
        	<number>31</number>
        	<color>#000000</color>
        	<fontsize>22</fontsize>
			<font>Sergio UI</font>
			<fontstyle>bold</fontstyle>
			<verticalalignment>bottom</verticalalignment>
			<horizontalalignment>center</horizontalalignment>
			<marginbottom>-5</marginbottom>
			<percentage>true</percentage>
    	</plc_word>
		<group>feed_group</group>
	</border>
	<border>
		<column_span>3</column_span>
		<column_start>4</column_start>
		<fill>#012c3f</fill>
		<row_span>3</row_span>
		<row_start>11</row_start>
		<outline_color>#000000</outline_color>
		<outline_thickness>1</outline_thickness>
		<group>rapid_group</group>
	</border>
	<border>
		<column_span>3</column_span>
		<column_start>4</column_start>
		<fill>Transparent</fill>
		<row_span>1</row_span>
		<row_start>11</row_start>
		<outline_color>Transparent</outline_color>
		<outline_thickness>1</outline_thickness>
		<plc_word>
        	<number>58</number>
        	<color>#ffffff</color>
        	<fontsize>22</fontsize>
			<font>Sergio UI</font>
			<fontstyle>bold</fontstyle>
			<verticalalignment>bottom</verticalalignment>
			<horizontalalignment>center</horizontalalignment>
			<marginbottom>-5</marginbottom>
			<percentage>true</percentage>
    	</plc_word>
		<group>rapid_group</group>
	</border>
	<border>
		<column_span>3</column_span>
		<column_start>4</column_start>
		<fill>#0b71aa</fill>
		<row_span>3</row_span>
		<row_start>11</row_start>
		<outline_color>#000000</outline_color>
		<outline_thickness>1</outline_thickness>
		<group>linked_group</group>
	</border>
	<border>
		<column_span>3</column_span>
		<column_start>4</column_start>
		<fill>Transparent</fill>
		<row_span>1</row_span>
		<row_start>11</row_start>
		<outline_color>Transparent</outline_color>
		<outline_thickness>1</outline_thickness>
		<plc_word>
        	<number>31</number>
        	<color>#ffffff</color>
        	<fontsize>22</fontsize>
			<font>Sergio UI</font>
			<fontstyle>bold</fontstyle>
			<verticalalignment>bottom</verticalalignment>
			<horizontalalignment>center</horizontalalignment>
			<marginbottom>-5</marginbottom>
			<percentage>true</percentage>
    	</plc_word>
		<group>linked_group</group>
	</border>
  <image>
    <column_span>1</column_span>
    <column_start>1</column_start>
    <row_span>1</row_span>
    <row_start>5</row_start>
    <path>resources\vcp\images\coolant.svg</path>
  </image>
  <image>
    <column_span>1</column_span>
    <column_start>1</column_start>
    <row_span>4</row_span>
    <row_start>1</row_start>
    <path>resources\vcp\images\spindlecontrol.svg</path>
  </image>
  <image>
    <column_span>1</column_span>
    <column_start>1</column_start>
    <row_span>5</row_span>
    <row_start>6</row_start>
    <path>resources\vcp\images\axismotioncontrols.svg</path>
  </image>
	<image>
		<column_span>3</column_span>
		<column_start>4</column_start>
		<row_span>1</row_span>
		<row_start>11</row_start>
		<path>C:\cncm\resources\vcp\images\feedrate_override.svg</path>
		<group>feed_group</group>
	</image>
	<image>
		<column_span>3</column_span>
		<column_start>4</column_start>
		<row_span>1</row_span>
		<row_start>11</row_start>
		<path>C:\cncm\resources\vcp\images\rapid_override.svg</path>
		<group>rapid_group</group>
	</image>
	<image>
		<column_span>3</column_span>
		<column_start>4</column_start>
		<row_span>1</row_span>
		<row_start>11</row_start>
		<path>C:\cncm\resources\vcp\images\linked_override.svg</path>
		<group>linked_group</group>
	</image>
  <on_click>
    <opacity>100</opacity>
    <outline_color>#000000</outline_color>
  </on_click>
  <on_hover>
    <opacity>100</opacity>
    <outline_color>#ffffff</outline_color>
  </on_hover>

	<hide_group>
		<group>rapid_group</group>
        <group>feed_group</group>
	</hide_group>  

	<button row="1" column="2">spindle_plus</button>
	<button row="1" column="3">spindle_auto_man</button>
	<button row="1" column="4">aux1</button>
	<button row="1" column="5">aux2</button>
	<button row="1" column="6">aux3</button>
	<button row="2" column="2">spindle_100</button>
	<button row="2" column="3">spindle_cw</button>
	<button row="2" column="4">aux4</button>
	<button row="2" column="5">aux5</button>  
	<button row="2" column="6">aux6</button>
	<button row="3" column="2">spindle_minus</button>
	<button row="3" column="3">spindle_ccw</button>
	<button row="3" column="4">aux7</button>
	<button row="3" column="5">aux8</button>
	<button row="3" column="6">aux9</button>
	<button row="4" column="2">spindle_cancel</button>
	<button row="4" column="3">spindle_start</button>
	<button row="4" column="4">aux10</button>
	<button row="4" column="5">aux11</button>
	<button row="4" column="6">aux12</button>
	<button row="5" column="2">coolant_auto_man</button>
	<button row="5" column="3">flood_coolant</button>
	<button row="5" column="4">coolant_pump</button>
	<button row="5" column="5">aux13_legacy</button>
	<button row="5" column="6">aux14_legacy</button>
	<button row="6" column="2">incr_cont</button>
	<button row="6" column="3">x1</button>
	<button row="6" column="4">x10</button>
	<button row="6" column="5">x100</button>
	<button row="6" column="6">mpg</button>
	<button row="7" column="2">4th_positive</button>
	<button row="7" column="4">y_positive</button>
	<button row="7" column="6">z_positive</button>
	<button row="8" column="3">x_negative</button>
	<button row="8" column="4">tortoise_hare</button>
	<button row="8" column="5">x_positive</button>
	<button row="9" column="2">4th_negative</button>
	<button row="9" column="4">y_negative</button>
	<button row="9" column="6">z_negative</button>
	<button row="10" column="2">cycle_cancel</button>
	<button row="10" column="3">single_block</button>
	<button row="10" column="4">tool_check</button>
	<button row="10" column="5">feed_hold</button>
	<button row="10" column="6">cycle_start</button>
	<button row="11" column="4" group="unlinked_group">rapid_feed</button>
	<button row="11" column="4" group="linked_group">rapid_feed_linked</button>
	<button row="11" column="6">rapid_feed_link</button>
	<button row="12" column="1" column_span="3" row_span="3">reset</button>
	<button row="12" column="4" group="feed_button_group">feedrate_negative</button>
	<button row="12" column="5" group="feed_button_group">feedrate_100</button>
	<button row="12" column="6" group="feed_button_group">feedrate_positive</button>
	<button row="13" column="4" group="feed_button_group">feedrate_25</button>
	<button row="13" column="5" group="feed_button_group">feedrate_50</button>
	<button row="13" column="6" group="feed_button_group">feedrate_75</button>
	<button row="12" column="4" group="rapid_group">rapidrate_negative</button>
	<button row="12" column="5" group="rapid_group">rapidrate_100</button>
	<button row="12" column="6" group="rapid_group">rapidrate_positive</button>
	<button row="13" column="4" group="rapid_group">rapidrate_25</button>
	<button row="13" column="5" group="rapid_group">rapidrate_50</button>
	<button row="13" column="6" group="rapid_group">rapidrate_75</button>
	<button row="14" column="4">vcp_options</button>
	<button row="14" column="5">push_free</button>
</vcp_skin>