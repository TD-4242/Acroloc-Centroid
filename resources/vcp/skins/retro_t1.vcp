<vcp_skin>
	<background>#141210</background>
	<on_click>
		<opacity>100</opacity>
		<outline_color>#000000</outline_color>
	</on_click>
	<on_hover>
		<opacity>100</opacity>
		<outline_color>#ffffff</outline_color>
	</on_hover>
	<button row="3" column="2">spindle_plus</button>
	<button row="6" column="3">x1</button>
	<button row="10" column="2">cycle_start</button>
	<button row="10" column="6">feed_hold</button>
</vcp_skin>
