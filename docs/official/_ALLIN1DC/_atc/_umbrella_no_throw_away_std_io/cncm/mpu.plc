;- Kb_r              IS SV_PC_KEYBOARD_KEY_42
;- Kb_s              IS SV_PC_KEYBOARD_KEY_61
;- Kb_t              IS SV_PC_KEYBOARD_KEY_43
;- Kb_u              IS SV_PC_KEYBOARD_KEY_45
;- Kb_v              IS SV_PC_KEYBOARD_KEY_78
