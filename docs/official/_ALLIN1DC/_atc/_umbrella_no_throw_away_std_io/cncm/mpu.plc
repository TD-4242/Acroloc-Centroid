;- Kb_spacebar       IS SV_PC_KEYBOARD_KEY_95
;- Kb_L_Shift        IS SV_PC_KEYBOARD_KEY_74
;- Kb_R_Shift        IS SV_PC_KEYBOARD_KEY_85
