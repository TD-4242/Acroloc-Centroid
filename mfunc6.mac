;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; File: mfunc6.mac
; Desc: Tool Change Macro
;
; Stages:
;   ATCStage
;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;Skip if graphing or searching
IF #4202 || #4201 THEN GOTO 1000
; Acroloc -- T0 = declare the spindle EMPTY (no motion, no changer). CNC12 still does
; its end-of-M6 bookkeeping: the tool that was in the spindle goes back to its
; putback bin and the spindle becomes 'no tool', so the next M6 to that tool is
; not skipped. Used after a hand-moved carousel / at boot (see plcmacro5.mac).
IF #4120 == 0 THEN GOTO 900
IF #50001       ; Prevent lookahead
M109 /1/2       ; Disable overrides

S0
M5              ; stop spindle
M9              ; Turn off coolant
M101 /50012     ; wait for ZeroSpeed_I (INP12) ON = spindle confirmed stopped before Z enters changer
G53 Z0          ; Move Z to tool change position
M107            ; Send the requested tool's BIN (enhanced ATC, P160=1: CNC12 looks it up in the Tool Library)
G4 P.1          ; wait .1 second
M94 /8          ; Set M6_SV to start tool change stage
G4 p1           ; wait 1 second (can I shorten this wait?)
; Acroloc -- the chosen carousel bin is shown live on the retro VCP (BIN readout),
; from TargetToolBinDisp_W (W8). No macro message here: M225 is a modal box that
; would pause the change until dismissed.
M100 /93016     ; ATCStage RST (carousel matched, motor off, PLC now reports the new bin)
G4 P2           ; Let CNC12's carousel-position monitor SEE the new bin before the M6 ends:
                ; CNC12 records the new tool's putback from the position it last saw, and
                ; without this dwell the M6 ended within ~100 ms of the match, so the
                ; putback intermittently kept the previous tool's bin (on-machine 2026-09-08).
M95 /8          ; reset M6_SV to stop tool change stage when done
G10 P700 R[#4120] ; Hand the PLC the requested TOOL number for the VCP TOOL readout. MUST stay after M95 /8:
                ; a G10 issued mid-M6 made CNC12 commit the tool library early and record the new
                ; tool's putback from the carousel position BEFORE the move (on-machine 2026-09-08).

M108 /1/2       ; Re-enable overrides (pairs the M109 /1/2 above -- an unpaired
                ; M109 leaves override control off for the rest of the program,
                ; which also disables CNC12's G74/G84 feed-override lockout)

GOTO 1000

N900            ; T0 path: nothing in the spindle -> VCP TOOL readout 0
G10 P700 R0

N1000           ; end of program